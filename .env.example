# YouTube Data API v3 Key (Google Cloud Console)
YOUTUBE_API_KEY="your_youtube_api_key_here"

# Upstash Redis (Serverless Redis for caching, velocity tracking & multi-tier rate limiting)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"

# PostgreSQL Database Connection Strings (Prisma ORM 7)
# Pooled connection URL (e.g. Supabase connection pooler or standard Postgres connection)
DATABASE_URL="postgresql://postgres:password@host:5432/postgres?pgbouncer=true"
# Direct connection URL for running Prisma migrations
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

# Google Gemini AI API Key (Gemini 2.5 Flash for strategic creator insights)
GEMINI_API_KEY="your_gemini_api_key_here"

# Google OAuth 2.0 Credentials (YouTube readonly scope to sync creator channel)
NUXT_OAUTH_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
NUXT_OAUTH_GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# Nuxt Auth Utils Session Encryption Secret (Random string, min 32 chars)
NUXT_SESSION_PASSWORD="your_random_session_password_min_32_chars_long"
